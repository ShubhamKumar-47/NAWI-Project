# ==============================================================================
# NAWI Test Report Management System (NTRMS)
# Environment Configuration Template (.env.example)
# ==============================================================================

# ── Django Core Settings ──────────────────────────────────────────────────────
# Production: Set to False. Development: True.
DEBUG=False

# Django settings module: config.settings.production or config.settings.development
DJANGO_SETTINGS_MODULE=config.settings.production

# Cryptographic secret key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1,your-custom-domain.com

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://your-custom-domain.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://nawi_user:StrongPassword123!@localhost:5432/nawi_trms
DB_CONN_MAX_AGE=600

# ── Redis & Celery (Asynchronous Tasks & Caching) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security & HTTPS Configuration ────────────────────────────────────────────
# Set to True when served behind HTTPS (automatic on Render, AWS, or Nginx with SSL)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── Default Administrator Account (Used on initial bootstrap) ─────────────────
ADMIN_EMAIL=admin@nawi.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_ORG=National Metrology Testing Center
ACCREDITATION_NUMBER=ISO-17025-NTRMS-001

# ── Email Delivery (SMTP) ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key
DEFAULT_FROM_EMAIL=reports@nawi-metrology.org

# ── Cloud Media Storage (AWS S3 - Optional) ───────────────────────────────────
# Leave blank to use persistent disk volume (/var/data/media)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# ── Sentry Error Monitoring (Optional) ────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

